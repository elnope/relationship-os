# Relationship OS - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# Connection string for your Supabase PostgreSQL database.
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# 
# IMPORTANT: Leave this empty to run the app in Demo Mode with mock data.
# This is perfect for testing without setting up a database.
#
# Example:
# DATABASE_URL="postgresql://postgres:mysecretpassword@db.xyzabc.supabase.co:5432/postgres"

DATABASE_URL=

# =============================================================================
# SUPABASE (Optional - for future auth features)
# =============================================================================
# Only needed if you want to implement user authentication with Supabase Auth.

# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env.local to version control
# - Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - DATABASE_URL is server-side only and never exposed to the browser
