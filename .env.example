# Relationship OS - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
# 
# IMPORTANT: You need TWO connection strings from Supabase:
# 1. DATABASE_URL - For the application (uses transaction pooler)
# 2. DIRECT_URL - For Prisma migrations (direct connection)
#
# Get these from: Supabase Dashboard → Settings → Database → Connection String

# -----------------------------------------------------------------------------
# Option 1: Application Connection (Transaction Pooler - Port 6543)
# Use this for DATABASE_URL
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# -----------------------------------------------------------------------------
# Option 2: Direct Connection (For Migrations - Port 5432)
# Use this for DIRECT_URL
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# =============================================================================
# NOTES
# =============================================================================
# - Never commit .env.local to version control
# - DATABASE_URL uses port 6543 (PgBouncer) for app runtime
# - DIRECT_URL uses port 5432 (direct) for Prisma migrations
# - Both are required for Supabase with connection pooling
